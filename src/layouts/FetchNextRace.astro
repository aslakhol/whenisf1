---
import currentYear from "../currentYear.json";
import { getNextRaceTable } from "../lib/raceData";
import PreSeasonMain from "../views/PreSeasonMain.astro";
import Main from "../views/Main.astro";
import type { ApiRace, SessionKey } from "../types";

export interface Props {
  session: string;
  sessionKey?: SessionKey;
}

const { session, sessionKey } = Astro.props;

const raceTable = await getNextRaceTable();
const nextRace = raceTable.Races[0];

const isSprint = Boolean(
  nextRace?.Sprint || nextRace?.SprintQualifying || nextRace?.SprintShootout
);

const resolveSession = (race: ApiRace | undefined, key: SessionKey | undefined) => {
  if (!race || !key) return race;

  switch (key) {
    case "FirstPractice":
      return race.FirstPractice || race;
    case "SecondPractice":
      return race.SecondPractice || race.SprintQualifying || race.SprintShootout || race;
    case "ThirdPractice":
      return race.ThirdPractice || race.Sprint || race;
    case "Qualifying":
      return race.Qualifying || race;
    case "Sprint":
      return race.Sprint || race.ThirdPractice || race;
    case "SprintQualifying":
      return race.SprintQualifying || race.SprintShootout || race.SecondPractice || race;
    case "SprintShootout":
      return race.SprintShootout || race.SprintQualifying || race.SecondPractice || race;
  }
};

const circuit = nextRace?.Circuit.Location.locality || "unknown";
const race = resolveSession(nextRace, sessionKey);

const preSeason =
  raceTable.Races.length < 1 || race?.date === undefined;

const seasonOpener = currentYear.MRData.RaceTable.Races[0];
const fallbackGoTime = seasonOpener
  ? new Date(`${seasonOpener.date}T${seasonOpener.time ?? "15:00:00Z"}`)
  : new Date();

const goTime = race
  ? new Date(`${race.date}T${race.time ?? "15:00:00Z"}`)
  : fallbackGoTime;
---

{
  preSeason ? (
    <PreSeasonMain goTime={goTime} />
  ) : (
    <Main
      session={session}
      goTime={goTime}
      circuit={circuit}
      isSprint={isSprint}
    />
  )
}
